APP_ENV=development
SECRET_KEY=
SEED_DEMO_DATA=false
SESSION_COOKIE_SECURE=false

# Required only if SEED_DEMO_DATA=true. Use unique passwords with 12+ characters.
DEMO_ADMIN_PASSWORD=
DEMO_ENGINEER_PASSWORD=

# Login throttling defaults: 5 failures per IP+username in 10 minutes,
# followed by a 15-minute lockout. IP-wide protection defaults to 25 failures.
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_WINDOW_SECONDS=600
# LOGIN_LOCKOUT_SECONDS=900
# LOGIN_IP_MAX_ATTEMPTS=25

# Optional production database:
# DATABASE_URL=postgresql://user:password@host:5432/database

# Optional storage overrides:
# UPLOAD_FOLDER=/data/uploads
# EXPORT_FOLDER=/data/exports
# MAX_CONTENT_LENGTH=52428800
# MAX_IMPORT_FILE_SIZE=5242880
# MAX_IMPORT_ROWS=5000
